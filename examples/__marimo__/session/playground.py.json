            "text/html": "<marimo-accordion data-labels='[&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003e\ud83d\udd0e Events in cycle 0 (32)&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;]' data-multiple='false' data-expanded='[]'><div><marimo-ui-element object-id='emfo-0' random-id='c1f35424-728d-42f7-7a6a-84a53c89b67f'><marimo-table data-initial-value='[]' data-label='null' data-data='&quot;[{&#92;&quot;begin&#92;&quot;:&#92;&quot;0&#92;&quot;,&#92;&quot;end&#92;&quot;:&#92;&quot;1/8&#92;&quot;,&#92;&quot;s&#92;&quot;:&#92;&quot;bd&#92;&quot;},{&#92;&quot;begin&#92;&quot;:&#92;&quot;0&#92;&quot;,&#92;&quot;end&#92;&quot;:&#92;&quot;1/16&#92;&quot;,&#92;&quot;s&#92;&quot;:&#92;&quot;hh&#92;&quot;,&#92;&quot;gain&#92;&quot;:0.589,&#92;&quot;pan&#92;&quot;:0.328},{&#92;&quot;begin&#92;&quot;:&#92;&quot;0&#92;&quot;,&#92;&quot;end&#92;&quot;:&#92;&quot;1/8&#92;&quot;,&#92;&quot;n&#92;&quot;:12,&#92;&quot;s&#92;&quot;:&#92;&quot;pluck&#92;&quot;,&#92;&quot;cutoff&#92;&quot;:2030.209,&#92;&quot;delay&#92;&quot;:0.3,&#92;&quot;room&#92;&quot;:0.3},{&#92;&quot;begin&#92;&quot;:&#92;&quot;0&#92;&quot;,&#92;&quot;end&#92;&quot;:&#92;&quot;1/16&#92;&quot;,&#92;&quot;s&#92;&quot;:&#92;&quot;rim&#92;&quot;,&#92;&quot;room&#92;&quot;:0.4,&#92;&quot;gain&#92;&quot;:0.9},{&#92;&quot;begin&#92;&quot;:&#92;&quot;1/16&#92;&quot;,&#92;&quot;end&#92;&quot;:&#92;&quot;1/8&#92;&quot;,&#92;&quot;s&#92;&quot;:&#92;&quot;hh&#92;&quot;,&#92;&quot;gain&#92;&quot;:0.5,&#92;&quot;pan&#92;&quot;:0.322},{&#92;&quot;begin&#92;&quot;:&#92;&quot;1/8&#92;&quot;,&#92;&quot;end&#92;&quot;:&#92;&quot;1/4&#92;&quot;,&#92;&quot;s&#92;&quot;:&#92;&quot;cp&#92;&quot;,&#92;&quot;room&#92;&quot;:0.3},{&#92;&quot;begin&#92;&quot;:&#92;&quot;1/8&#92;&quot;,&#92;&quot;end&#92;&quot;:&#92;&quot;3/16&#92;&quot;,&#92;&quot;s&#92;&quot;:&#92;&quot;hh&#92;&quot;,&#92;&quot;gain&#92;&quot;:0.692,&#92;&quot;pan&#92;&quot;:0.316},{&#92;&quot;begin&#92;&quot;:&#92;&quot;1/8&#92;&quot;,&#92;&quot;end&#92;&quot;:&#92;&quot;1/4&#92;&quot;,&#92;&quot;n&#92;&quot;:17,&#92;&quot;s&#92;&quot;:&#92;&quot;pluck&#92;&quot;,&#92;&quot;cutoff&#92;&quot;:1977.827,&#92;&quot;delay&#92;&quot;:0.3,&#92;&quot;room&#92;&quot;:0.3},{&#92;&quot;begin&#92;&quot;:&#92;&quot;3/16&#92;&quot;,&#92;&quot;end&#92;&quot;:&#92;&quot;1/4&#92;&quot;,&#92;&quot;s&#92;&quot;:&#92;&quot;hh&#92;&quot;,&#92;&quot;gain&#92;&quot;:0.724,&#92;&quot;pan&#92;&quot;:0.31},{&#92;&quot;begin&#92;&quot;:&#92;&quot;1/4&#92;&quot;,&#92;&quot;end&#92;&quot;:&#92;&quot;5/16&#92;&quot;,&#92;&quot;s&#92;&quot;:&#92;&quot;hh&#92;&quot;,&#92;&quot;gain&#92;&quot;:0.51,&#92;&quot;pan&#92;&quot;:0.304},{&#92;&quot;begin&#92;&quot;:&#92;&quot;1/4&#92;&quot;,&#92;&quot;end&#92;&quot;:&#92;&quot;3/8&#92;&quot;,&#92;&quot;n&#92;&quot;:19,&#92;&quot;s&#92;&quot;:&#92;&quot;pluck&#92;&quot;,&#92;&quot;cutoff&#92;&quot;:1925.445,&#92;&quot;delay&#92;&quot;:0.3,&#92;&quot;room&#92;&quot;:0.3},{&#92;&quot;begin&#92;&quot;:&#92;&quot;5/16&#92;&quot;,&#92;&quot;end&#92;&quot;:&#92;&quot;3/8&#92;&quot;,&#92;&quot;s&#92;&quot;:&#92;&quot;hh&#92;&quot;,&#92;&quot;gain&#92;&quot;:0.403,&#92;&quot;pan&#92;&quot;:0.298}]&quot;' data-total-rows='32' data-total-columns='9' data-max-columns='50' data-banner-text='&quot;&quot;' data-pagination='true' data-page-size='12' data-show-filters='false' data-show-download='true' data-show-search='true' data-show-column-summaries='true' data-show-data-types='true' data-show-page-size-selector='true' data-show-column-explorer='true' data-show-chart-builder='true' data-row-headers='[]' data-hidden-columns='[]' data-has-stable-row-id='false' data-lazy='false' data-preload='false'></marimo-table></marimo-ui-element></div></marimo-accordion>"
