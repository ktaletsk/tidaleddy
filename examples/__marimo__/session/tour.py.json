      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h3 id=\"rhythms-from-a-cellular-automaton\">Rhythms from a cellular automaton</h3>\n<span class=\"paragraph\">An <a href=\"https://en.wikipedia.org/wiki/Elementary_cellular_automaton\" rel=\"noopener noreferrer\" target=\"_blank\">elementary cellular automaton</a>\nturns a row of cells into the next row by a rule numbered 0 to 255. Each row makes a\nrhythm: a live cell is a rim shot. Four generations, one per cycle. Try rules 30, 90,\n105 and 150.</span></span>"
          }
        }
      ],
      "console": []
