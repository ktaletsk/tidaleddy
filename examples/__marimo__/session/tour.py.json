          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">A little more <a href=\"https://ktaletsk.github.io/tidaleddy/mini-notation/\" rel=\"noopener noreferrer\" target=\"_blank\">mini-notation</a>:\n<code>(3,8)</code> is a Euclidean rhythm (3 hits spread over 8 steps), <code>?0.4</code> drops 40% of the\nhits at random, and <code>{ }</code> lets patterns of different lengths drift against each other.</span></span>"
          }
        }
      ],
      "console": []
